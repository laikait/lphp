{
    "name": "laikait/lphp",
    "description": "Module-first, hook/filter driven backend PHP framework.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "psr/container": "^2.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.75",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5",
        "twig/twig": "^3.8"
    },
    "autoload": {
        "psr-4": {
            "App\\Engine\\": "engine/",
            "App\\Modules\\Shared\\": "modules/shared/",
            "App\\Modules\\Plugins\\": "modules/plugins/",
            "App\\Modules\\Gateways\\": "modules/gateways/"
        },
        "files": [
            "engine/Support/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        },
        "classmap": [
            "tests/Fixtures/"
        ]
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "platform": {
            "php": "8.2.0"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:unit": "phpunit --testsuite unit",
        "test:feature": "phpunit --testsuite feature",
        "stan": "phpstan analyse --memory-limit=512M",
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs:fix": "php-cs-fixer fix",
        "check": [
            "@cs",
            "@stan",
            "@test"
        ],
        "serve": "php -S 127.0.0.1:8080 server.php",
        "console": "php bin/console"
    },
    "scripts-descriptions": {
        "check": "Full quality gate: coding standard, static analysis, tests.",
        "serve": "Run the development server on http://127.0.0.1:8080",
        "console": "Run the framework console."
    }
}
