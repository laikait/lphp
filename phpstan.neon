parameters:
    level: 8
    tmpDir: system/Runtime/phpstan
    paths:
        - engine
        - tests
    treatPhpDocTypesAsCertain: false

    # composer.json says the framework runs on ^8.1, and this is what makes that
    # claim true rather than aspirational. Analysing across the whole supported
    # range reports 8.2-only syntax -- readonly classes, never in an arrow
    # function, constants in traits -- on EVERY run, on whatever PHP the
    # developer happens to have. The alternative is finding out from the one CI
    # job that runs the oldest version, hours later and only if it was pushed.
    phpVersion:
        min: 80100
        max: 80500

    typeAliases:
        # Anything the container knows how to invoke: a closure, a function or
        # "Class::method" string, an invokable object, or [target, method].
        InvokableTarget: 'callable|array{0: object|class-string, 1: string}|string'
