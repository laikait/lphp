/vendor/
/system/Cache/*
/system/Logs/*
/system/Runtime/*
# Created on demand by the file queue store; jobs are data, never source.
/system/Queue/
# Created on demand by the scheduler; a lock is one process's claim, not state.
/system/Schedule/
!/system/Cache/.gitignore
!/system/Logs/.gitignore
!/system/Runtime/.gitignore

